{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash .claude/hooks/post-tool-use.sh",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "bash .claude/hooks/post-tool-failure.sh",
            "type": "command"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bash .claude/hooks/pre-compact.sh",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash .claude/hooks/pre-tool-use.sh",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|Read|Grep|Glob|Bash"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "bash .claude/hooks/session-end.sh",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash .claude/hooks/session-start.sh",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash .claude/hooks/stop.sh",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "bash .claude/hooks/subagent-start.sh",
            "type": "command"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "command": "bash .claude/hooks/task-completed.sh",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash .claude/hooks/prompt-submit.sh",
            "type": "command"
          }
        ]
      }
    ]
  },
  "customCommands": [
    {
      "name": "cargar-estado",
      "prompt": "Lee detalladamente el archivo .opencode/ESTADO_PROYECTO.md. Basándote en la sección de \"Próximos Pasos\" y \"Objetivo Actual\", indícame exactamente en qué fase nos quedamos y pregúntame cómo deseas proceder."
    },
    {
      "name": "inicia-sesion",
      "prompt": "Quiero iniciar la sesión de trabajo. Por favor, usa tu herramienta bash para levantar los servicios locales si están apagados (por ejemplo docker, ollama) y confírmame que todo está listo para trabajar. Si no sabes el comando exacto, asume que Ollama y Supabase ya están corriendo en background."
    }
  ]
}