        "jsCode": "try {\n  const jsonStr = $input.first().json.text.replace(/```json\\n/g, '').replace(/```/g, '');\n  return { success: true, appointments: JSON.parse(jsonStr) };\n} catch(e) {\n  return { success: false, error: e.message };\n}"
