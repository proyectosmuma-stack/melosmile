        "jsCode": "\nconst title = $json.title || 'Sin título';\nconst description = $json.description || 'Sin descripción';\nreturn {\n  json: {\n    action: 'create',\n    target_db: 'PUBLICACIONES',\n    properties: {\n      Title: { title: [{ text: { content: title } }] },\n      Status: { select: { name: 'research' } },\n      Content: { rich_text: [{ text: { content: description } }] }\n    }\n  }\n};\n"
