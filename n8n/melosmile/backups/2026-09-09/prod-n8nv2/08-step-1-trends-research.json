      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst clientName = 'MELOSMILE';\nconst niche = 'salud bucal y estética dental';\n\n// Extract content from Notion pages\nconst posts = items.map(item => {\n  const props = item.json.properties || {};\n  const title = props.Title?.title?.[0]?.plain_text || props.Name?.title?.[0]?.plain_text || 'Sin título';\n  const content = props.Content?.rich_text?.[0]?.plain_text || props.Description?.rich_text?.[0]?.plain_text || '';\n  const platform = props.Platform?.select?.name || '';\n  const format = props.Meta_Format?.select?.name || '';\n  return { title, content, platform, format };\n}).filter(p => p.content.length > 0);\n\nconst postsText = posts.map((p, i) => `${i+1}. [${p.platform}/${p.format}] ${p.title}: ${p.content.substring(0, 300)}`).join('\\n\\n');\n\nconst prompt = `Basado en los siguientes posts recientes de ${clientName} (${niche}), investiga y detecta las 3-5 tendencias más relevantes en el nicho. La respuesta debe ser un array JSON con objetos: { \"title\": \"Nombre tendencia\", \"description\": \"Descripción\", \"relevance\": \"Alta/Media/Baja\", \"angles\": [\"ángulo1\", \"ángulo2\"] }.\n\nPosts recientes:\\n${postsText}`;\n\nreturn [{ json: { prompt, clientName: 'MELOSMILE', niche: 'salud bucal y estética dental', postsCount: posts.length } }];"
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "jsonBody": "={{ JSON.stringify({ model: 'anthropic/claude-3-haiku', messages: [{ role: 'user', content: $json.prompt }], temperature: 0.7, max_tokens: 2000 }) }}",
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json"
      },
      "name": "OpenRouter Agent: Trend Research",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "id": "4",
      "position": [
        780,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "k3cjhrV4qfsLVzPE",
          "name": "OpenRouter"
        }
      },
      "executeOnce": true
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const response = $json;\nconst content = response.choices?.[0]?.message?.content || '';\nif (!content) {\n  return { json: { error: 'No content' } };\n}\n// Extract JSON array from text\nlet trends;\ntry {\n  const jsonMatch = content.match(/\\[\\s*\\{.*\\}\\s*\\]/s);\n  if (jsonMatch) {\n    trends = JSON.parse(jsonMatch[0]);\n  } else {\n    trends = JSON.parse(content);\n  }\n} catch (e) {\n  trends = [{ title: 'Tendencia detectada', description: content.substring(0, 200), relevance: 'Media', angles: ['revisar'] }];\n}\nif (!Array.isArray(trends) || trends.length === 0) {\n  trends = [{ title: 'Tendencia detectada', description: 'Ver contenido', relevance: 'Media', angles: ['revisar'] }];\n}\n// Return FIRST trend only (one page per trend)\nconst trend = trends[0];\nreturn { json: { title: trend.title || 'Tendencia', description: trend.description || 'Sin descripción', relevance: trend.relevance || 'Media', angles: JSON.stringify(trend.angles || []) } };"
      },
