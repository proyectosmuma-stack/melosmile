        "jsCode": "\n// MOCK TEMPORAL del Asset Generator - pendiente de definir servicio de imagenes real\n// Toma el output del Copywriter/Visual Prompter y prepara el shape para Notion Update + Step 4\nconst items = $input.all();\nreturn items.map(item => {\n  const j = item.json || {};\n  // Extraer copy del response de OpenRouter si existe\n  let copy = j.copy_data || j.copy || '';\n  if (!copy && j.choices && j.choices[0] && j.choices[0].message) {\n    copy = j.choices[0].message.content || '';\n  }\n  const notionId = j.notionId || j.page_id || j.id || '';\n  return {\n    json: {\n      ...j,\n      notionId,\n      copy_data: copy,\n      asset_urls: 'MOCK_ASSET_PENDING_SERVICE',\n      title: j.title || ''\n    }\n  };\n});\n"
      },
