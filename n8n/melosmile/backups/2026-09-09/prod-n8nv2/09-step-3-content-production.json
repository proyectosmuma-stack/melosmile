      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst clientName = 'MELOSMILE';\nconst niche = 'salud bucal y estética dental';\n\n// Extract content from Notion pages\nconst posts = items.map(item => {\n  const props = item.json.properties || {};\n  const title = props.Title?.title?.[0]?.plain_text || props.Name?.title?.[0]?.plain_text || 'Sin título';\n  const content = props.Content?.rich_text?.[0]?.plain_text || props.Description?.rich_text?.[0]?.plain_text || '';\n  const platform = props.Platform?.select?.name || '';\n  const format = props.Meta_Format?.select?.name || '';\n  return { title, content, platform, format };\n}).filter(p => p.content.length > 0);\n\nconst postsText = posts.map((p, i) => `${i+1}. [${p.platform}/${p.format}] ${p.title}: ${p.content.substring(0, 300)}`).join('\\n\\n');\n\nconst prompt = `Basado en los siguientes posts recientes de ${clientName} (${niche}), investiga y detecta las 3-5 tendencias más relevantes en el nicho. La respuesta debe ser un array JSON con objetos: { \"title\": \"Nombre tendencia\", \"description\": \"Descripción\", \"relevance\": \"Alta/Media/Baja\", \"angles\": [\"ángulo1\", \"ángulo2\"] }.\n\nPosts recientes:\\n${postsText}`;\n\nreturn [{ json: { prompt, clientName: 'MELOSMILE', niche: 'salud bucal y estética dental', postsCount: posts.length } }];"
      }
    },
